# Dependencies
node_modules/
# NOTE: package-lock.json is intentionally committed for reproducible CI/CD builds.

# Build output
dist/
build/
# NOTE: frontend/dist is generated during CI/CD and on the server — never commit it.

# Environment variables (contains secrets)
.env
.env.local
.env.*.local
.env.production
.env.docker
.env.production.local

# OS
.DS_Store
._*
.AppleDouble
.LSOverride

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp

# Sensitive configs (VPN, deployment) — keep paths we WANT to commit out of this block.
# Only the following sensitive artifacts are ignored; scripts/ and .vscode/ are tracked.
DEPLOYED.md
server-dashboard.service
*.pem
*.key

# Telegram agent (Python) — secrets & virtualenv
telegram-agent/.env
telegram-agent/.venv/
**/__pycache__/
*.pyc
*.pyo
