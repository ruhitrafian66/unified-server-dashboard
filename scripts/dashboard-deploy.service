[Unit]
Description=Unified Server Dashboard - pull-based deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs the deploy script in-place on the server. Because this is a oneshot
# unit (not long-running), it exits after each poll and is re-armed by the
# associated timer.
ExecStart=/bin/bash /opt/dashboard/scripts/deploy.sh
# Deployment is idempotent + quick, so retry on transient failure.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
