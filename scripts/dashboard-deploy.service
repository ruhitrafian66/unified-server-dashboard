[Unit]
Description=Unified Server Dashboard - pull-based deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/server-dashboard/scripts/deploy.sh
# No Restart=: the timer re-runs this every few minutes, and a failed commit is
# remembered by deploy.sh so it isn't retried in a loop.
TimeoutStartSec=20min
# Builds are heavy on a small ARM board; don't starve Plex or downloads.
Nice=10
IOSchedulingClass=idle
Environment=NODE_OPTIONS=--max-old-space-size=512
