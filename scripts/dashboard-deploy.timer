[Unit]
Description=Unified Server Dashboard - poll for a new deploy-ready build

[Timer]
OnBootSec=2min
# Re-check every 2 minutes after the previous run finished. A no-change check
# is a single `git ls-remote` and prints nothing.
OnUnitInactiveSec=2min
RandomizedDelaySec=15s
Unit=dashboard-deploy.service

[Install]
WantedBy=timers.target
