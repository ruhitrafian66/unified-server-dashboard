[Unit]
Description=Unified Server Dashboard
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# Root is needed for the Docker socket, `systemctl reboot/poweroff` and /proc.
User=root
WorkingDirectory=/opt/server-dashboard/backend
Environment=NODE_ENV=production
# backend/.env is loaded by the app via dotenv; PORT defaults to 3001.
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Give in-flight requests a moment on stop/restart.
TimeoutStopSec=10
# Guard rails: cap memory on a 2 GB board and keep the process away from
# system files it never needs to write.
MemoryMax=400M
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
