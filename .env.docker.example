# IMPORTANT: Never commit actual .env.docker file with real credentials
# This file is used by docker-compose.yml
# Copy to .env.docker and fill in real values on the server only

# WireGuard Configuration (from ProtonVPN or your VPN provider)
WIREGUARD_PRIVATE_KEY=your-wireguard-private-key-here
WIREGUARD_PUBLIC_KEY=your-wireguard-public-key-here
WIREGUARD_ENDPOINT_IP=your-vpn-endpoint-ip-here
